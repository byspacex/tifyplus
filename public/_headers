/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://sdk.scdn.co https://open.spotify.com https://embed-cdn.spotifycdn.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.spotify.com https://accounts.spotify.com https://musicbrainz.org https://*.spotify.com https://*.scdn.co https://*.spotifycdn.com wss://*.spotify.com; media-src 'self' blob: https://*.scdn.co https://*.spotifycdn.com; worker-src 'self' blob:; frame-src https://*.spotify.com; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.spotify.com; frame-ancestors 'none'; upgrade-insecure-requests
